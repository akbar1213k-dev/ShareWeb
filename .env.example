# ===== Database (Vercel Postgres / Neon) =====
# Dapatkan dari dashboard Vercel -> tab Storage -> Postgres, atau dari Neon.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===== Google Drive API (Service Account) =====
# 1. https://console.cloud.google.com -> buat project
# 2. Aktifkan "Google Drive API"
# 3. IAM & Admin -> Service Accounts -> Create Service Account
# 4. Buat kunci JSON -> download -> salin client_email dan private_key
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL = nilai "client_email" pada file JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"

# GOOGLE_PRIVATE_KEY = nilai "private_key" pada file JSON.
# Ganti literal \n (baris baru) dengan newline asli, atau gunakan format
# dengan \\n seperti di bawah (dibaca sebagai newline oleh aplikasi).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (Opsional) ID folder Google Drive tempat semua file disimpan.
# Buat folder di Google Drive, share ke email service account, lalu isi ID-nya.
GOOGLE_DRIVE_FOLDER_ID=""
