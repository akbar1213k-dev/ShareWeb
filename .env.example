# ===== Database (Vercel Postgres / Neon) =====
# Dapatkan dari dashboard Vercel -> tab Storage -> Postgres, atau dari Neon.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===== Penyimpanan file: Backblaze B2 (S3-compatible) =====
# 1. https://secure.backblazeb2.com/b2_buckets.htm -> buat bucket (gratis 10GB, tanpa kartu)
# 2. Bucket Settings -> "Allow List All File Names" -> Enable
# 3. Account -> Application Keys -> Add New Application Key
#    - Capabilities: Read, Write, List, Delete (semua centang)
#    - Salin keyID (Access Key) dan applicationKey (Secret)
#
# S3_ENDPOINT = dari halaman bucket, bagian "S3 API Endpoint"
#               (bentuk: https://s3.<region>.backblazeb2.com)
S3_ENDPOINT="https://s3.us-west-002.backblazeb2.com"

# keyID dan applicationKey dari Backblaze B2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Nama bucket B2
S3_BUCKET_NAME=""

# Region hanya diperlukan untuk beberapa client S3; Backblaze biasanya tidak
# butuh. Default "auto" aman.
# S3_REGION="us-west-000"

# (Opsional) Base URL publik bucket untuk link download langsung, jika diaktifkan
# "Bucket Settings -> Browse" atau custom domain.
# S3_PUBLIC_URL=""
